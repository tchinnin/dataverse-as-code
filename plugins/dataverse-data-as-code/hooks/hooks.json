{
  "description": "Validate the Dataverse data-as-code model after any *.dv.data.yaml edit (Claude Code).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/dvac-data/scripts/hook_validate.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

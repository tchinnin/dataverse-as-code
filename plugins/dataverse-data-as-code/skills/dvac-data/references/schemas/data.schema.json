{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tchinnin/dataverse-as-code/dvac-data/data.schema.json",
  "title": "Dataverse data as code — one table (base file or stage overlay)",
  "type": "object",
  "additionalProperties": false,
  "required": ["table"],
  "properties": {
    "table": {
      "$ref": "#/definitions/name",
      "description": "Logical name of the table. The file is named <table>.dv.data.yaml."
    },
    "key": {
      "description": "Alternate key columns that identify each row (an Active alternate key with exactly these columns must exist). Required in a base file; an overlay inherits it.",
      "oneOf": [
        {"$ref": "#/definitions/name"},
        {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/name"}}
      ]
    },
    "deletion": {
      "description": "What happens to rows inside delete_filter that are not in the file. Default none.",
      "enum": ["none", "deactivate", "delete"]
    },
    "delete_filter": {
      "description": "OData $filter of the rows this file owns, or 'all'. Required when deletion is not none.",
      "type": "string",
      "minLength": 1
    },
    "bypass": {
      "description": "Business logic skipped while writing: custom sync/async plug-ins and workflows, Power Automate flows.",
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["sync", "async", "flows"]}
    },
    "rows": {
      "type": "array",
      "items": {"$ref": "#/definitions/row"}
    }
  },
  "definitions": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "scalar": {"type": ["string", "number", "boolean", "null"]},
    "row": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/definitions/name"},
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/definitions/scalar"},
          {"type": "array", "items": {"type": "integer"}},
          {"$ref": "#/definitions/reference"}
        ]
      }
    },
    "reference": {
      "description": "A row of another table: by alternate key (key) or by a query that finds exactly one row (match).",
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": {"$ref": "#/definitions/name"},
        "key": {"$ref": "#/definitions/values"},
        "match": {"$ref": "#/definitions/values"}
      },
      "oneOf": [{"required": ["key"]}, {"required": ["match"]}]
    },
    "values": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/definitions/name"},
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    }
  }
}

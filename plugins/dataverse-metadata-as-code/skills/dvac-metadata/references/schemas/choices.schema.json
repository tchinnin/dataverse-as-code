{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dataverse choices.dv.metadata.yaml",
  "description": "All global Choices (option sets) of the model, keyed by Schema Name.",
  "type": "object",
  "required": ["choices"],
  "additionalProperties": false,
  "properties": {
    "choices": {
      "type": "object",
      "description": "Global Choices keyed by Schema Name: {prefix}_[{project_code}_]choice_{ChoiceName}.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]{1,7}_([a-z0-9]+_)?choice_[A-Za-z][A-Za-z0-9]*$"
      },
      "additionalProperties": { "$ref": "#/definitions/choice" }
    }
  },
  "definitions": {
    "localizedText": {
      "description": "A string in the base language, or a map {LCID: text}, e.g. {1033: Customer, 1036: Client}.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[0-9]{4,5}$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "choice": {
      "type": "object",
      "required": ["label", "options"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/definitions/localizedText",
          "description": "Display Name — the base-language text ends with ' Choice'."
        },
        "description": { "$ref": "#/definitions/localizedText" },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/option" }
        }
      }
    },
    "option": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1,
          "description": "Option value. Custom values start at 100000000."
        },
        "label": { "$ref": "#/definitions/localizedText" },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Optional hex color (e.g. #1B8ED4)."
        }
      }
    }
  }
}
